{
  "name": "spectra-launcher",
  "productName": "Spectra Launcher",
  "version": "0.3.1",
  "description": "Spectra Launcher — home for Spectra games",
  "author": "Spectra",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "preview": "python -m http.server 5190"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.spectra.launcher",
    "productName": "Spectra Launcher",
    "artifactName": "SpectraLauncherSetup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "src/**/*",
      "Assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "Assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spectra Launcher",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nautiquatic",
        "repo": "Spectra"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
