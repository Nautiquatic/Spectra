{
  "name": "spectra-launcher",
  "productName": "Spectra Launcher",
  "version": "0.1.0",
  "description": "Spectra Launcher — home for Spectra games",
  "author": "Spectra",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "preview": "python -m http.server 5190",
    "postdist": "node -e \"const fs=require('fs');fs.mkdirSync('website/downloads',{recursive:true});fs.copyFileSync('dist/SpectraLauncherSetup.exe','website/downloads/SpectraLauncherSetup.exe');console.log('Copied installer to website/downloads/SpectraLauncherSetup.exe')\""
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.spectra.launcher",
    "productName": "Spectra Launcher",
    "artifactName": "SpectraLauncherSetup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "Assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "Assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spectra Launcher",
      "runAfterFinish": true
    }
  }
}
